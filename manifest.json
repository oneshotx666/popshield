{
  "manifest_version": 3,
  "name": "PopShield",
  "version": "1.0.0",
  "description": "Blocks new-tab popups and in-page overlays on every site.",

  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "scripting"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/state.js",
        "content/clickjack-blocker.js",
        "content/overlay-blocker.js",
        "content/scroll-lock-fixer.js",
        "content/observer.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "popup_rules",
        "enabled": true,
        "path": "rules/popup-rules.json"
      }
    ]
  },


  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
